<?xml version="1.0"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Launch orchestration for JetAuto Orin AMR development and robot profiles.</description>
  <maintainer email="nithish@example.com">Nithish</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Node packages are added back here as each is rebuilt; see
       launch_lib/actions.py NODE_SPECS for the matching launch entry. -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
