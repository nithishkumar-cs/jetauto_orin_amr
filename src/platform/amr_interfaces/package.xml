<?xml version="1.0"?>
<package format="3">
  <name>amr_interfaces</name>
  <version>0.1.0</version>
  <description>
    Custom message contracts for the JetAuto AMR stack — only the types ROS has
    no standard for (tracked obstacles with velocity, and the safety verdict).
    Detection uses vision_msgs; health uses diagnostic_msgs.
  </description>
  <maintainer email="nithishk.ips@gmail.com">Nithish</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>vision_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
